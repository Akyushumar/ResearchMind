# ResearchMind Configuration
RESEARCHMIND_ENV=development
RESEARCHMIND_DEBUG=true
RESEARCHMIND_LOG_LEVEL=DEBUG

# PostgreSQL
RESEARCHMIND_DATABASE_URL=postgresql+asyncpg://researchmind:researchmind@localhost:5432/researchmind

# Qdrant
RESEARCHMIND_QDRANT_HOST=localhost
RESEARCHMIND_QDRANT_PORT=6333
RESEARCHMIND_QDRANT_COLLECTION=researchmind_evidence

# LLM & Embedding Providers
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=3072

# Gemini
GEMINI_API_KEY=

# OpenAI (Fallback)
OPENAI_API_KEY=

# File Storage
RESEARCHMIND_UPLOAD_DIR=./data/uploads
